# Copy to .env and replace placeholders.
# REPOSCOPE_* vars are loaded by app.config.Settings

# Analyzer: stub | llm
REPOSCOPE_ANALYZER_PROVIDER=llm
REPOSCOPE_LLM_API_KEY=YOUR_LLM_API_KEY
# Any OpenAI-compatible endpoint works — change these to switch models:
#   DeepSeek:  https://api.deepseek.com  + deepseek-chat
#   OpenAI:    https://api.openai.com/v1 + gpt-4o-mini
#   Ollama:    http://127.0.0.1:11434/v1 + llama3.1  (key can be ollama)
REPOSCOPE_LLM_BASE_URL=https://api.deepseek.com
REPOSCOPE_LLM_MODEL=deepseek-chat
REPOSCOPE_LLM_TIMEOUT_SEC=90
REPOSCOPE_LLM_JSON_RESPONSE=true

# Optional infra
# REPOSCOPE_DATABASE_URL=postgresql://reposcope:reposcope@localhost:5432/reposcope
# REPOSCOPE_REDIS_URL=redis://localhost:6379/0
# REPOSCOPE_VECTOR_BACKEND=qdrant
# REPOSCOPE_QDRANT_URL=http://localhost:6333

# Optional file watcher (python -m app.watch --repo ...)
# REPOSCOPE_WATCH_DEBOUNCE_MS=2000
# REPOSCOPE_WATCH_POLL_MS=1500
