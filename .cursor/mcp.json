{
  "mcpServers": {
    "reposcope": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "app.mcp.server"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "REPOSCOPE_ARTIFACT_DIR": "${workspaceFolder}/data/artifacts",
        "REPOSCOPE_WORKSPACE_ROOT": "${workspaceFolder}/data/workspace"
      }
    }
  }
}
